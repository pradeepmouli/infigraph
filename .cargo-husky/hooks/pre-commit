#!/bin/sh
set -e

# Dev-loop env vars that opt a shell into daemon-backed indexing
# (INFIGRAPH_BACKEND=daemon) or watcher auto-start (INFIGRAPH_WATCH_DAEMON)
# are meant for interactive use, not for this hook's own test/build
# subprocesses -- a shell profile that sets them globally otherwise makes
# tests like groups_watch_perf fail with "Cannot create an empty database
# under READ ONLY mode" for reasons unrelated to the change being committed.
#
# INFIGRAPH_BACKEND is PINNED rather than unset (#159): unsetting it only
# means "run locally" for as long as local is the default, and that is the
# thing #159 flips. The other two have no such default to invert.
export INFIGRAPH_BACKEND=kuzu
unset INFIGRAPH_WATCH_DAEMON INFIGRAPH_INDEX_VIA_DAEMON

# `cargo clippy --all-targets` alone forces a full workspace rebuild (100+
# crates, including native lbug/kuzu builds) -- wasted work for a docs-only
# change, and has repeatedly exhausted disk on machines running close to
# their space limit. Skip the Rust checks entirely when every staged file
# is documentation (under docs/, or any *.md).
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
non_docs=$(printf '%s\n' "$staged_files" | grep -v -E '^docs/|\.md$' || true)

if [ -n "$staged_files" ] && [ -z "$non_docs" ]; then
    echo 'pre-commit: docs-only change, skipping Rust checks'
    exit 0
fi

echo '+cargo fmt -- --check'
cargo fmt -- --check

echo '+cargo clippy --all-targets -- -D warnings'
cargo clippy --all-targets -- -D warnings

echo '+cargo test -p infigraph-core --test write_lock_perf -- --ignored'
cargo test -p infigraph-core --test write_lock_perf -- --ignored

# groups_watch_perf spawns the `infigraph` CLI binary next to the test
# executable, and infigraph-mcp has no dependency on infigraph-cli, so
# `cargo test -p infigraph-mcp` never rebuilds it. A binary left over from
# another branch (different lbug version) makes the test fail silently
# ("No results across repos"). Building it here costs one link step.
echo '+cargo build -p infigraph-cli'
cargo build -p infigraph-cli

echo '+cargo test -p infigraph-mcp --test groups_watch_perf -- --ignored'
cargo test -p infigraph-mcp --test groups_watch_perf -- --ignored

echo '+cargo test -p infigraph-core --test index_perf -- --ignored'
cargo test -p infigraph-core --test index_perf -- --ignored

# #183: lbug reclaims freed pages only partially, so a graph under repeated
# delete/recreate churn grows without bound. This is the invariant whose
# absence let #175-#179 each ship one at a time -- the growth breaker (#100)
# is a ratio tripwire consulted *between* operations, so it cannot express
# "this round changed nothing and should have cost ~nothing".
#
# `--lib`, not `--test`: it is a unit test, because the size it measures comes
# from `store_util::graph_family_bytes`, which is `pub(crate)`.
echo '+cargo test -p infigraph-core --lib -- --ignored unchanged_content_churn_stays_within_its_measured_bound'
cargo test -p infigraph-core --lib -- --ignored unchanged_content_churn_stays_within_its_measured_bound
